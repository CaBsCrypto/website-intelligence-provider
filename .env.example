# Public Testnet configuration. Copy to .env.local; never commit real secrets.
X402_PUBLIC_BASE_URL=https://provider.example
X402_ALLOWED_PUBLIC_BASE_URLS=https://provider.example
X402_STELLAR_PAY_TO=
STELLAR_X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_SETTLEMENT_ENABLED=false
X402_MANUAL_SINGLE_PROCESS_TESTNET=false

# Required only for an explicitly authorized settlement attempt. Keep it server-only.
STELLAR_X402_FACILITATOR_API_KEY=

# Dedicated durable state for the paid provider route. Do not reuse Bazaar keys.
# Required for settlement on Vercel/multi-instance runtimes; server-only.
WEBSITE_INTELLIGENCE_REDIS_REST_URL=
WEBSITE_INTELLIGENCE_REDIS_REST_TOKEN=

# Paid live HTML reports require durable Redis and explicit settlement enablement.
WEBSITE_INTELLIGENCE_LIVE_ENABLED=false

# Derive origin from VERCEL_URL only in explicitly enabled Preview deployments.
X402_USE_PREVIEW_ORIGIN=false
